{
  "workspace": ["./web/client", "./web/server"],
  "tasks": {
    "wasmbuild": "deno run -A @deno/wasmbuild",
    "genkey": "deno run --allow-read=./lib/ --allow-write genkey.ts",
    "dev": "deno task --cwd web/server dev",
    "build:lib": "deno bundle client/mod.ts --sourcemap=external --output client/mod.js",
    "build": "deno task --cwd web/server build",
    "build:cf": "deno task --cwd web/server build:cf",
    "cf": "deno run -A npm:cf@1.0.0-beta.24",
    "test": "deno test -P",
    "check": "deno check . && deno lint && deno fmt --check"
  },
  "imports": {
    "@cloudflare/build-output-utils": "npm:@cloudflare/build-output-utils@0.9.5",
    "@cloudflare/config": "npm:@cloudflare/config@0.28.1",
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0.23.0",
    "@remix-kbn/assets-deno": "jsr:@remix-kbn/assets-deno@^0.9.0",
    "@remix-kbn/ssg": "jsr:@remix-kbn/ssg@^0.13.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/msgpack": "jsr:@std/msgpack@^1.0.3",
    "cf": "npm:cf@1.0.0-beta.24",
    "remix": "npm:remix@^3.2.0"
  },
  "nodeModulesDir": "auto",
  "unstable": ["bundle"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component"
  },
  "exclude": [
    "dist/",
    "node_modules/",
    "client/mod.js",
    "web/dist/",
    "web/worker-dist/",
    ".cloudflare/"
  ],
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "import": true
    }
  }
}
