{
  "tasks": {
    "wasmbuild": "deno run -A @deno/wasmbuild",
    "genkey": "deno run --allow-read=./lib/ --allow-write genkey.ts",
    "server": "deno serve -P server.ts",
    "build": "deno bundle client/mod.ts --sourcemap=external --output client/mod.js",
    "build:worker": "deno bundle --platform=browser --external='*.wasm' worker/entry.ts -o=dist/worker.js"
  },
  "imports": {
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0.23.0",
    "@hono/hono": "jsr:@hono/hono@^4.13.14",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/msgpack": "jsr:@std/msgpack@^1.0.3"
  },
  "exclude": ["dist/", "node_modules/", "client/mod.js"],
  "permissions": {
    "default": {
      "read": ["./lib/"],
      "env": ["IBKEM_PUBLIC_KEY", "IBKEM_SECRET_KEY"]
    }
  }
}
